---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quantum Charge — Proyecto conceptual de branding",
  description =
    "Quantum Charge: concepto de marca, diseño de packaging y experiencia web para una colección de bebidas energéticas.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/images/smalllogo.png" type="image/png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
      }

      body {
        display: flex;
        flex-direction: column;
        background-color: #000000;
        font-family: "Bebas Neue";
      }

      @media (prefers-reduced-motion: reduce) {
        :global(html) {
          scroll-behavior: auto;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
