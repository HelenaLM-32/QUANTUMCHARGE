---
const isProcessPage = Astro.url.pathname.startsWith("/proceso");
---

<nav aria-label="Navegación principal">
  <a href="/#inicio" aria-label="Quantum Charge, inicio">
    <img class="logo" src="/images/logo.png" alt="Quantum Charge" />
  </a>

  <a class="brand-note" href={isProcessPage ? "/#inicio" : "/proceso/"}>
    {isProcessPage
      ? "PROYECTO CONCEPTUAL · VOLVER A LA LANDING"
      : "PROYECTO CONCEPTUAL · VER PROCESO"}
    <span aria-hidden="true">↗</span>
  </a>

  <style>
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem clamp(1rem, 4vw, 3rem);
    }

    .logo {
      display: block;
      width: min(170px, 42vw);
      height: auto;
    }

    .brand-note {
      margin: 0;
      color: #ff6123;
      font-family: "Space Mono", monospace;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-align: right;
      text-decoration: none;
    }

    .brand-note:hover {
      color: #f5efe5;
    }

    @media (max-width: 768px) {
      nav {
        gap: 0.75rem;
      }

      .brand-note {
        max-width: 12rem;
        text-align: right;
        font-size: 0.6rem;
      }
    }
  </style>
</nav>
