<style>
  .galeria {
    text-align: center;
    padding-top: 10px;
  }

  h2 {
    font-size: clamp(2.25rem, 8vw, 6.25rem);
    line-height: 0.95;
    margin-bottom: 30px;
    margin-top: 10px;
    color: #ff6123;
    padding: 0 1rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #f5efe5;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  p {
    color: #ff6123;
    font-family: "Space Mono", monospace;
    line-height: 1.7;
  }

  .latas {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(12px, 2vw, 24px);
    margin-bottom: 10px;
    padding: 0 1rem;
  }

  .lata {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: clamp(135px, 19vw, 220px);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
    padding: 12px 12px 18px;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 12px;
    background: linear-gradient(160deg, #151515, #080808);
  }

  .lata:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgb(255 97 35 / 12%);
  }

  .lata:focus-within {
    outline: 2px solid #ff6123;
    outline-offset: 4px;
  }

  .lata img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.35;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .lata:hover img {
    transform: scale(1.04);
  }

  .sabor {
    margin: 0.5rem 0 0;
    color: #f5efe5;
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    letter-spacing: 0.04em;
  }

  .nota-sabor {
    margin: 0.2rem 0 0;
    color: #aaa49b;
    font-family: "Space Mono", monospace;
    font-size: 0.65rem;
  }

  .descripcion {
    width: min(90%, 48rem);
    margin: 0 auto 2rem;
  }

  @media (max-width: 768px) {
    h2 {
      margin-bottom: 20px;
    }

    .descripcion p {
      text-align: center;
    }

    .lata {
      width: clamp(130px, 38vw, 180px);
    }
  }
</style>

<section class="galeria" id="productos">
  <p class="eyebrow">COLECCIÓN 01 / CUATRO SABORES</p>
  <h2>ENCUENTRA TU ÓRBITA</h2>
  <div class="descripcion">
    <p>
      Cuatro perfiles, una misma energía visual. Descubre la colección Quantum
      Charge y elige el sabor que va contigo.
    </p>
  </div>
  <div class="latas">
    <article class="lata">
      <img src="/images/1.png" alt="Lata Quantum Charge Berry Blast" loading="lazy" />
      <h3 class="sabor">BERRY BLAST</h3>
      <p class="nota-sabor">FRUTOS ROJOS</p>
    </article>
    <article class="lata">
      <img src="/images/2.png" alt="Lata Quantum Charge Citrus Burst" loading="lazy" />
      <h3 class="sabor">CITRUS BURST</h3>
      <p class="nota-sabor">CÍTRICOS</p>
    </article>
    <article class="lata">
      <img src="/images/3.png" alt="Lata Quantum Charge Tropical Punch" loading="lazy" />
      <h3 class="sabor">TROPICAL PUNCH</h3>
      <p class="nota-sabor">FRUTAS TROPICALES</p>
    </article>
    <article class="lata">
      <img src="/images/4.png" alt="Lata Quantum Charge Cosmic Grape" loading="lazy" />
      <h3 class="sabor">COSMIC GRAPE</h3>
      <p class="nota-sabor">UVA</p>
    </article>
  </div>
</section>
