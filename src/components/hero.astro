<style>
    .hero {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: clamp(400px, 62vw, 680px);
        overflow: hidden;
        background: #080808;
    }

    video {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        color: #ff6123;
        text-align: center;
        width: min(100% - 2rem, 1000px);
        padding: 3rem 0;
    }

    .hero-product {
        display: none;
    }

    .hero-title {
        font-size: clamp(2.5rem, 9vw, 7rem);
        line-height: 0.95;
        font-weight: bold;
        margin: 0;
    }

    .hero-subtitle {
        margin-top: 0;
        font-size: clamp(1rem, 2vw, 1.5rem);
        margin-bottom: 2rem;
    }

    .cta-button {
        width: 100px;
        color: #ff6123;
        padding: 0.75rem 1.5rem;
        border: none;
        font-size: 15px;
        border-radius: 4px;
        text-decoration: none;
        transition: background 0.3s ease;
        border: solid #ff6123;
        border-radius: 50%;
    }

    .cta-button:hover {
        background-color: #ff6123;
        color: black;
    }

    @media (max-width: 768px) {
        .hero {
            min-height: min(76svh, 620px);
            background:
                radial-gradient(ellipse at 76% 68%, rgb(255 97 35 / 18%), transparent 52%),
                linear-gradient(145deg, #111, #050505 72%);
        }

        .hero-product {
            position: absolute;
            right: -4%;
            bottom: -10%;
            display: block;
            width: min(46vw, 220px);
            max-height: 92%;
            object-fit: contain;
            opacity: 0.78;
            filter: drop-shadow(0 18px 36px rgb(255 97 35 / 14%));
            pointer-events: none;
        }

        .hero-subtitle {
            margin-bottom: 1rem;
        }

        .cta-button {
            font-size: 14px;
            padding: 0.5rem 1rem;
            width: auto;
            border-radius: 20px;
        }

        .hero-content {
            align-self: flex-start;
            margin-top: clamp(2rem, 8vh, 4rem);
            padding: 2rem 0;
            text-align: left;
            text-shadow: 0 2px 18px #000;
        }

        .hero-title {
            max-width: 8ch;
            font-size: clamp(2.6rem, 10vw, 4rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero video {
            display: none;
        }
    }
</style>

<section class="hero" id="inicio" aria-label="Presentación de Quantum Charge">
    <video autoplay muted loop playsinline preload="metadata" poster="/images/tophero.png" aria-hidden="true">
        <source src="/videos/hero.mp4" type="video/mp4" />
        Tu navegador no admite vídeos HTML5.
    </video>
    <img class="hero-product" src="/images/2.png" alt="" aria-hidden="true" />
    <div class="hero-content">
        <h1 class="hero-title">QUANTUM CHARGE</h1>
        <p class="hero-subtitle">Una nueva órbita de sabor.</p>
        <a href="#productos" class="cta-button">Explora la colección</a>
    </div>
</section>
