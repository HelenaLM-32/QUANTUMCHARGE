<style>
    .hero {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: clamp(400px, 62vw, 680px);
        overflow: hidden;
    }

    video {
        position: absolute;
        inset: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        color: #ff6123;
        text-align: center;
        width: min(100% - 2rem, 1000px);
        padding: 3rem 0;
    }

    .hero-title {
        font-size: clamp(2.5rem, 9vw, 7rem);
        line-height: 0.95;
        font-weight: bold;
        margin: 0;
    }

    .hero-subtitle {
        margin-top: 0;
        font-size: clamp(1rem, 2vw, 1.5rem);
        margin-bottom: 2rem;
    }

    .cta-button {
        width: 100px;
        color: #ff6123;
        padding: 0.75rem 1.5rem;
        border: none;
        font-size: 15px;
        border-radius: 4px;
        text-decoration: none;
        transition: background 0.3s ease;
        border: solid #ff6123;
        border-radius: 50%;
    }

    .cta-button:hover {
        background-color: #ff6123;
        color: black;
    }

    @media (max-width: 768px) {
        .hero {
            min-height: 400px;
        }

